# ── Base de datos ─────────────────────────────────────────────
# Opción A (sin instalar nada): Postgres embebido, guarda en server/.data/pg
DATABASE_URL=pglite://./.data/pg
# Opción B: Postgres real (docker compose up -d, o brew install postgresql@17)
# DATABASE_URL=postgres://vetquiz:vetquiz@localhost:5432/vetquiz

# ── Gemini (SOLO backend; nunca exponer al cliente) ───────────
GEMINI_API_KEY=
# Flash estable vigente según ai.google.dev/gemini-api/docs/models (oct-2026)
GEMINI_MODEL=gemini-3.8-flash

# ── Servidor ──────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Archivos > este tamaño se suben con la File API en vez de inline
GEMINI_INLINE_MAX_MB=15
# PDFs más pesados se dividen en partes (Gemini acepta máx. 50 MB por PDF)
GEMINI_PDF_CHUNK_MAX_MB=40
UPLOAD_MAX_MB=150
STORAGE_DIR=./uploads
# Zona horaria para la racha diaria
APP_TIMEZONE=America/Bogota

# ── Solo en la nube ───────────────────────────────────────────
# Código para entrar desde internet (mínimo 8 caracteres). Vacío = sin código (uso local).
ACCESS_CODE=
# En la nube: NODE_ENV=production. STATIC_DIR y STORAGE_DIR ya vienen en el Dockerfile.
# NODE_ENV=production

# ── Premios de Ashley ─────────────────────────────────────────
# Código de la página #/admin (entregar premios, editarlos, regalar huesitos). Obligatorio en la nube.
ADMIN_CODE=
# Tu WhatsApp con indicativo y sin "+" (ej. 573001234567): ahí te llega el aviso cuando ella reclama un premio
ADMIN_WHATSAPP=
OWNER_NAME=Ashley

# Perfiles con su propio código, "nombre:código" separados por coma. El primero debe ser "ash" (la dueña).
# Con esto, ACCESS_CODE ya no abre dispositivos nuevos (los que ya habían entrado siguen siendo de Ash).
# PROFILE_CODES=ash:codigo-de-ash,magola:codigo-de-magola

# ── Vercel ──────────────────────────────────────────────────
# DATABASE_URL lo pone Neon (Storage → Neon) y BLOB_READ_WRITE_TOKEN lo pone Vercel Blob (Storage → Blob).
# Con BLOB_READ_WRITE_TOKEN los archivos se suben directo del celular a Vercel Blob (sin el límite de 4,5 MB).
# BLOB_READ_WRITE_TOKEN=
